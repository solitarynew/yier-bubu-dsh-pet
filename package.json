{
  "name": "yier-bubu-dsh-pet",
  "version": "0.5.1",
  "private": true,
  "description": "一二布布桌宠：基于 dsh-pet 的双人版与组合版，右键控制与可开关靠近互动",
  "dependencies": {
    "dsh-pet": "0.3.7"
  },
  "scripts": {
    "start": "node scripts/install.mjs",
    "stop": "node scripts/runtime.mjs stop",
    "status": "node scripts/runtime.mjs status",
    "build:assets": "python3 scripts/build_assets.py",
    "start:pair": "node scripts/install.mjs --mode pair",
    "start:duo": "node scripts/install.mjs --mode duo",
    "start:keyboard": "node scripts/install.mjs --mode keyboard-pair",
    "start:keyboard:yier": "node scripts/install.mjs --mode keyboard-yier",
    "start:keyboard:bubu": "node scripts/install.mjs --mode keyboard-bubu",
    "test": "node --test",
    "pretest": "node scripts/patch-desktop.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
